# Courthouse environment. Copy to services/core/.env and fill in. Never commit .env.
# `make deploy` uploads it to the Courthouse Sprite and forces PROBATE_FAKE=0,
# PROBATE_RUN_CLOCK=1 and PROBATE_DATA_DIR=/home/sprite/data there.

# Fly.io: Sprites API token (sprites.dev dashboard) and a long random admin secret
PROBATE_SPRITES_TOKEN=
PROBATE_ADMIN_TOKEN=

# Connector gateway connection IDs, one per provider (Sprites dashboard → Connectors)
PROBATE_CONNECTIONS={"typesafe":"","box":"","pinecone":"","agentmail":"","elevenlabs":"","ollama":"","anthropic":""}
TYPESAFE_BASE_URL=https://api.sprites.dev/v1/gateway/typesafe/<connection_id>
TYPESAFE_API_KEY=sprites

# AgentMail inboxes: the family's own, plus three test senders we control
PROBATE_FAMILY_INBOX=
PROBATE_OWNER_INBOX=
PROBATE_FRIEND_INBOX=
PROBATE_STRANGER_INBOX=

# Life and budget
PROBATE_LIFESPAN_SECONDS=600
PROBATE_GAP_SECONDS=60
PROBATE_SUITE_PER_LIFE=8
PROBATE_BRAIN=ollama:gpt-oss:120b
PROBATE_BUDGET_USD=20

# Optional: generations get the Courthouse's own code bundle, so this is only a link for humans
PROBATE_REPO_URL=https://github.com/<owner>/probate
