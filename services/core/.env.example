# Courthouse environment. Copy to services/core/.env and fill in. Never commit .env.
# `make deploy` uploads it to the Courthouse Sprite and forces PROBATE_FAKE=0,
# PROBATE_RUN_CLOCK=1 and PROBATE_DATA_DIR=/home/sprite/data there.

# Fly.io: Sprites API token (sprites.dev dashboard) and a long random admin secret
PROBATE_SPRITES_TOKEN=
PROBATE_ADMIN_TOKEN=

# Connector gateway connection IDs, one per provider (Sprites dashboard → Connectors)
# A Custom API connector is addressed by its type, so write its entry as "custom_api/<id>".
PROBATE_CONNECTIONS={"typesafe":"","box":"","pinecone":"","agentmail":"","elevenlabs":"","ollama":"","anthropic":"","cloudflare":"","apify":""}
# Card P1: with an "apify" connection set, each email's first link is read by Apify's RAG Web Browser
# and the page goes through the gate and the court like everything else. 0 turns it off.
# PROBATE_LINKS_PER_MAIL=1
# PROBATE_APIFY_ACTOR=apify~rag-web-browser
# Where the web fixtures' pages live; must be the owner's own domain (apps/site/public/suite/).
# PROBATE_PAGES_BASE=https://probate.dualmindlab.tech/suite
# Jev through Cloudflare Workers AI instead of the TypeSafe connector (model typesafe/jev, $0.042 per
# million input tokens, billed from the Cloudflare account's AI Gateway credits). Needs PROBATE_CF_ACCOUNT_ID
# and a Workers AI permission on the `cloudflare` connector's token. Then TYPESAFE_BASE_URL is not used.
# PROBATE_JEV=cloudflare
TYPESAFE_BASE_URL=https://api.sprites.dev/v1/gateway/typesafe/<connection_id>
TYPESAFE_API_KEY=sprites

# AgentMail inboxes: the family's own, plus two test senders we control (fits the free plan)
PROBATE_FAMILY_INBOX=
PROBATE_FRIEND_INBOX=
PROBATE_STRANGER_INBOX=

# The owner's own address. The suite's "from the owner" emails leave from it through Cloudflare
# Email Service (custom-API connector "cloudflare" above, pointed at api.cloudflare.com)
PROBATE_OWNER_SENDER=harsh@dualmindlab.tech
PROBATE_CF_ACCOUNT_ID=

# Mode. continuous (default): a life is always running. on_demand: the Courthouse sleeps until a
# visitor presses "Run a life"; PROBATE_RUN_CLOCK is then ignored and nothing free-runs.
# PROBATE_MODE=on_demand
# PROBATE_DEMO_LIFESPAN_SECONDS=120
# PROBATE_DEMO_SUITE_PER_LIFE=6
# PROBATE_DEMO_COOLDOWN_SECONDS=120
# PROBATE_DEMO_IP_PER_HOUR=3
# PROBATE_DEMO_MAX_PER_DAY=30
# PROBATE_DEMO_DAILY_BUDGET_USD=2
# PROBATE_DEMO_HARD_TIMEOUT_EXTRA_SECONDS=240
# PROBATE_DEMO_BIRTH_ALLOWANCE_SECONDS=120

# Judge key (real on-demand run): one long random shared secret that lets judges start a life and
# attack the family. Not an admin credential. At least 20 characters. See docs/13-RUNBOOK.md section 6.
# PROBATE_JUDGE_KEY=
# PROBATE_REQUIRE_KEY_FOR_PLAY=1   # default 1 in real on_demand mode, 0 otherwise
# PROBATE_JUDGE_LIVES_PER_HOUR=6
# PROBATE_JUDGE_DAILY_BUDGET_USD=5
# PROBATE_JUDGE_ATTACKS_PER_HOUR=60
# PROBATE_JUDGE_ATTACKS_PER_IP_MINUTE=6
# PROBATE_JUDGE_BAD_KEYS_PER_IP=8
# Behind the Cloudflare edge Worker (docs/EDGE.md): same value as the Worker's EDGE_TOKEN secret,
# 16+ random characters. Lets the per-address limits see the real visitor. Unset = no change.
# PROBATE_EDGE_TOKEN=
# Outgoing webhooks (docs/WEBHOOKS.md). Only the operator subscribes: here or via POST /admin/webhooks.
# PROBATE_WEBHOOK_URLS=https://hooks.example.com/probate
# PROBATE_WEBHOOK_SECRET=            # HMAC secret for the URLs above; use a long random value
# PROBATE_WEBHOOK_PORTS=443
# PROBATE_WEBHOOK_MAX_ENDPOINTS=10
# PROBATE_WEBHOOK_MAX_FAILURES=10    # consecutive failed attempts before an endpoint is disabled
# PROBATE_PUBLIC_URL=https://your-site.example   # origin used for links inside events
# PROBATE_WEBHOOK_ALLOW_INSECURE=1   # tests only: allows http://localhost. Never on a real Courthouse.

# Life and budget
PROBATE_LIFESPAN_SECONDS=600
PROBATE_GAP_SECONDS=60
PROBATE_SUITE_PER_LIFE=8
# AgentMail sends a UTC day on your plan (0 = no check). The clock waits for the next day
# rather than start a life whose test emails would not fit.
# PROBATE_MAIL_DAILY_LIMIT=100
# PROBATE_MAIL_RESERVE=6
PROBATE_BRAIN=ollama:gpt-oss:120b
# Workers AI instead (same model, billed by Cloudflare; the `cloudflare` connector's token also needs the
# Workers AI permission, and PROBATE_CF_ACCOUNT_ID must be set):
# PROBATE_BRAIN=cloudflare:@cf/openai/gpt-oss-120b
# Tried in order if the brain fails. Groq needs a Custom API connector named groq.
PROBATE_BRAIN_FALLBACKS=anthropic:claude-haiku-5-5
# PROBATE_BRAIN_FALLBACKS=groq:openai/gpt-oss-120b,anthropic:claude-haiku-5-5
PROBATE_BUDGET_USD=20

# Optional: generations get the Courthouse's own code bundle, so this is only a link for humans
PROBATE_REPO_URL=https://github.com/<owner>/probate
