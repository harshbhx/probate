// Cloudflare deploy for the landing page and docs: a Worker that serves the static export.
// `npm run build` writes ./out; `npx wrangler deploy` uploads it. No server code runs.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "probate-site",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
