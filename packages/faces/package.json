{
  "name": "kinfaces",
  "version": "0.1.0",
  "description": "Deterministic generated faces for a family line: each generation inherits its parent's face with one small change. Framework-free SVG strings, plus an optional React component.",
  "keywords": ["avatar", "avatars", "identicon", "generative", "svg", "faces", "deterministic", "procedural", "lineage", "react", "ssr"],
  "license": "MIT",
  "author": "Harsh Bhanushali <bhanushaliharsh434@gmail.com>",
  "homepage": "https://github.com/harshbhx/probate/tree/main/packages/faces#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshbhx/probate.git",
    "directory": "packages/faces"
  },
  "bugs": { "url": "https://github.com/harshbhx/probate/issues" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "default": "./dist/react.js" },
    "./faces.css": "./dist/faces.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md", "gallery.svg"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "gallery": "node scripts/gallery.mjs",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test \"src/*.test.ts\" \"test/*.test.mjs\"",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
