{
  // Open Probate in a browser with nothing to install: GitHub Codespaces (or any dev container tool) builds this,
  // simulates a 12-generation family with stand-in models, and opens the live family site on port 8080.
  // Every vendor is a stand-in here (PROBATE_FAKE=1), so no keys are needed and nothing leaves the container.
  "name": "Probate: a simulated family",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "postCreateCommand": "make setup && make sim",
  "postAttachCommand": { "live family": "make serve" },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Live family (simulated)", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "bradlc.vscode-tailwindcss"],
      "settings": { "python.defaultInterpreterPath": "services/core/.venv/bin/python" }
    }
  }
}
